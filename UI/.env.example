# Every VITE_ variable the code reads is compiled into the public JS bundle.
# Never put a secret here: API keys and the service-role key belong in
# backend/.env.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend. Defaults to http://localhost:8000.
VITE_API_BASE=http://localhost:8000

# Optional. Memory extraction via the `memory` Edge Function; on unless "false".
VITE_ENABLE_MEMORY=true

# Optional. While a user is signed in, ask the backend to run the job fetcher
# every VITE_JOB_FETCHER_SCHEDULER_MS (default 300000). Off unless "true".
VITE_ENABLE_JOB_FETCHER_SCHEDULER=false
VITE_JOB_FETCHER_SCHEDULER_MS=300000
