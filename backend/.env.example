# Model provider
GROQ_API_KEY=your_groq_api_key_here

# Model selection. The UI sends a key ('fast' | 'quality'); these map it to a
# model id. Groq retired the Llama 3.x models this app used (404
# model_not_found as of 2026-09-21). Confirm the account can reach a model
# before switching to it:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
MODEL_QUALITY=openai/gpt-oss-120b
MODEL_FAST=openai/gpt-oss-20b
# MODEL_TITLE and MODEL_REWRITE default to MODEL_FAST.
# MODEL_TITLE=
# MODEL_REWRITE=

# Only sent to reasoning models (gpt-oss): low | medium | high
REASONING_EFFORT=low

# Total request ceiling. Groq's free plan allows 8,000 tokens/minute across the
# whole organisation, so these are sized well below a single-request blowout.
# Prompt = system policy + memory + retrieved context + history.
MAX_PROMPT_TOKENS=4000
# Completion covers reasoning tokens too, not just the visible answer.
MAX_COMPLETION_TOKENS=1500

# Supabase (service key — server only, never expose to the browser)
# SUPABASE_URL also derives the token issuer and the JWKS endpoint, so it is
# required for authentication, not just for the job pipelines.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_OPTIONAL was deleted in Phase 2. It forgave a missing Authorization
# header for local development and the bench harness; both now obtain a real
# token from POST /api/guest/session instead. Once guest principals exist a
# flag that admits an unauthenticated caller is an escalation, not a
# convenience.

# Signing key for guest sessions. OPTIONAL -- leave it empty.
#
# By default the key is derived (HKDF-SHA256, domain-separated) from
# SUPABASE_SERVICE_KEY, which is already required for capability checks and
# both job pipelines. So guest sessions work anywhere the app meaningfully
# runs, with nothing extra to distribute, and every instance derives the same
# key so tokens verify across workers, restarts and hosts.
#
# This key's only job is to stop a client inventing its own guest id. A valid
# guest token is something anyone can obtain by asking
# POST /api/guest/session -- that is what the endpoint is for -- so it is not
# protecting anything an attacker could not simply request.
#
# Set it only if you want the guest key rotatable independently of the service
# key. An explicit value always wins:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Deliberately NOT SUPABASE_JWT_SECRET: that is the project's own session
# signing key, and sharing it would let this endpoint mint tokens
# indistinguishable from real user sessions.
#
# The startup line reports `guest_key: derived | explicit | missing`.
GUEST_JWT_SECRET=

# The `aud` claim Supabase puts on access tokens.
SUPABASE_JWT_AUD=authenticated

# Legacy HS256 projects only. This project's JWKS carries a single ES256 key, so
# a token arriving with alg=HS256 is anomalous and is logged as such. Leave
# empty unless the project still signs sessions symmetrically.
SUPABASE_JWT_SECRET=

# How long a fetched JWKS key set may be reused, in seconds.
JWKS_CACHE_SECONDS=600

# Comma-separated list of browser origins allowed to call this API.
# Defaults to the Vite dev server if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Total wall-clock budget for retrieval (query rewrite + search + page crawl),
# in seconds. Whatever finished in time is used; sources that were not crawled
# fall back to their search snippet.
RETRIEVAL_DEADLINE=6.0

# Per-page fetch timeout, in seconds.
CRAWL_TIMEOUT=10.0

# Thread pools for blocking work, bounded because an abandoned thread keeps
# running to completion regardless. HTML parsing and DNS lookups:
BLOCKING_POOL_SIZE=8
# The blocking web searches (two per chat turn), kept apart so a burst of
# searches can't starve parsing and DNS:
SEARCH_POOL_SIZE=32

# ── Knowledge base ────────────────────────────────────────────────────────────
# Embeddings for the knowledge base, from Google AI Studio (aistudio.google.com
# /apikey). REQUIRED once stage 4B ingests anything; until then nothing reads it.
#
# Not Vertex AI -- that serves the same models but needs a GCP project, a service
# account and OAuth, where this endpoint takes a plain key and no new dependency.
#
# Unlike GUEST_JWT_SECRET this cannot be derived from anything, so a host without
# it has no embeddings at all. Measured 2026-09-30 and worth not rediscovering:
#
#   * The model is gemini-embedding-2 with outputDimensionality=768.
#     text-embedding-004, which earlier plans named, no longer exists.
#   * It is natively 3072 dims and pgvector refuses an HNSW index above 2000, so
#     truncation is required, not tidy.
#   * gemini-embedding-001 truncated to 768 comes back UNNORMALISED (L2 ~0.59);
#     gemini-embedding-2 comes back normalised (~1.00). Cosine distance over an
#     unnormalised vector is wrong with no error and no failing test. Do not
#     switch models without re-checking the norm.
GOOGLE_API_KEY=

# ── Rate limits ───────────────────────────────────────────────────────────────
# Per-caller budgets, enforced in-process. Correct for the single uvicorn
# process this runs as; with N workers the effective limit is N x these, since
# each worker holds its own counters. See backend/ratelimit.py.
RATE_LIMIT_ENABLED=true
GUEST_RATE_PER_MIN=10
GUEST_RATE_BURST=4
USER_RATE_PER_MIN=30
USER_RATE_BURST=10
# Guards POST /api/guest/session itself, keyed by address. Without this the
# endpoint is a free token-minting oracle and the per-guest budget above means
# nothing.
GUEST_SESSION_PER_HOUR=20
GUEST_SESSION_BURST=5
# Concurrent in-flight requests per caller. A streaming answer holds its slot
# until the stream drains, not until the handler returns.
MAX_CONCURRENT_PER_PRINCIPAL=2

# Job fetcher (optional)
JOB_FETCHER_API_URL=
JOB_FETCHER_PERSIST_WORKER_RESULTS=false
PIPELINE_KEY=intern_jobs_alert

# ── Knowledge base ────────────────────────────────────────────────────────────
# Retrieval from the stored corpus, in front of live web search. Phase 4.
#
# KB_RETRIEVAL_ENABLED is the entire rollback for this feature: with it false,
# build_rag_prompt never calls the knowledge base and every answer is grounded
# the way it was before Phase 4. It is read per call, so flipping it needs no
# deploy.
#
# **Default is now true**, since 2026-10-01: stage 4D measured 9 of 10 eligible
# bench questions retrieving the right page at p50 422ms, with roughly half the
# context characters of live search, and the answers were judged good by hand.
# Set it to false to fall back to live web search for every turn.
KB_RETRIEVAL_ENABLED=true

# Budget for the whole lookup -- the embedding round trip to Google plus the
# Supabase query. On timeout the request falls through to live search, so this is
# a latency ceiling rather than a correctness setting. The shared Supabase
# client's own 3s read timeout is too long for a path on a chat turn.
KB_TIMEOUT=1.5

# How many chunks the hybrid search returns. Measured 2026-10-01 over the ten
# KB-eligible bench questions: at 12 the assembled context hit MAX_TOTAL_CHARS
# (median 7,646 chars, max 9,996) and was being truncated, so the knowledge base
# spent the whole prompt budget and the token-ceiling argument for building it
# evaporated. At 6 the median is 4,351 and sufficiency went *up*, to 10/10 -- the
# one miss at 12 was a timeout, not a ranking failure. 4 also scored 10/10.
KB_MAX_CHUNKS=6

# The sufficiency thresholds: answer from the corpus only above KB_MIN_RANK, and
# accept a single document only above KB_STRONG_RANK.
#
# **Calibrated 2026-10-01 against the live 35-document corpus.** RRF scores are
# not similarity scores -- they are sums of 1/(60 + rank_position) -- so what they
# measure is agreement between the keyword and vector arms, and the distribution
# is close to bimodal:
#
#   0.0164 = 1/61   one arm only. Vector search always returns its k nearest
#                   neighbours, so this is what "no real answer in the corpus"
#                   looks like. Measured for "thanks!" and for a nonsense query.
#   0.032  = 2/61   both arms rank it first. Measured for real questions
#                   ("where can visitors park" 0.0323, the transcript question
#                   0.0328).
#
# KB_MIN_RANK therefore sits between the modes: clearing it means both arms found
# the chunk. Raising it above ~0.033 would reject everything.
KB_MIN_RANK=0.02
KB_STRONG_RANK=0.03

# Seconds between requests to one host during ingestion, raised per host to
# whatever robots.txt asks for. www.sjsu.edu/robots.txt asks in plain English not
# to overload the servers; catalog.sjsu.edu sets crawl-delay: 120, which is ~30
# pages an hour and is why the catalog is its own overnight job.
KB_CRAWL_DELAY=1.0

# Registration browsing has its own rate-limit buckets (principal and address),
# so paging through class listings cannot spend the chat budget. These are cheap
# database reads, not provider tokens, hence higher than chat's 30/10 per
# minute: 60 for a signed-in user, 30 for a guest (half, as with chat's split).
# Burst is a third of the per-minute rate. The address bucket mirrors chat's
# generous IP_RATE_* numbers for the same NAT reason. Read per call.
REG_RATE_USER_PER_MIN=60
REG_RATE_USER_BURST=20
REG_RATE_GUEST_PER_MIN=30
REG_RATE_GUEST_BURST=10
REG_IP_RATE_PER_MIN=120
REG_IP_RATE_BURST=40
